{
  "name": "sayland",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "dev:api": "tsx apps/api/src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts && node scripts/build-api.mjs",
    "start:api": "node dist/api/server.mjs",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "9.8.1",
    "fastify": "5.12.5",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "^0.27.0",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
